<?xml version="1.0" encoding="utf-8"?>
<!-- bitFocus icon: a focus timer ring closing in on a single point. Hand-coded vector. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- faint full track -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2A3A6B"
        android:strokeWidth="4.5"
        android:pathData="M54,28 A26,26 0 1,1 54,80 A26,26 0 1,1 54,28" />
    <!-- timer progress arc (three quarters done) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#8CA6FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1,1 28,54" />
    <!-- inner focus ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#668CA6FF"
        android:strokeWidth="2.5"
        android:pathData="M54,40 A14,14 0 1,1 54,68 A14,14 0 1,1 54,40" />
    <!-- the single point of focus -->
    <path
        android:fillColor="#7CF5D4"
        android:pathData="M54,48 A6,6 0 1,1 54,60 A6,6 0 1,1 54,48 Z" />
    <!-- spark at the head of the arc -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,50.4 A3.6,3.6 0 1,1 28,57.6 A3.6,3.6 0 1,1 28,50.4 Z" />
</vector>
